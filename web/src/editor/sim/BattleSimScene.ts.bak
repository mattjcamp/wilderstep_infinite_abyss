/**
 * BattleSimScene — self-contained Phaser scene for the battle
 * simulator. Mounted from `/editor/[moduleId]/sim/battle`.
 *
 * Layout (canvas size sized from the chosen map at mount time):
 *
 *   ┌─ BATTLE banner ─────────────────────────────────────┐
 *   │                                                      │
 *   ├─ Arena (map tiles) ─────────────┬─ HUD ─────────────┤
 *   │  Combatant sprites on real      │ PARTY              │
 *   │  walkable cells. Cardinal       │ ┌──┐ Aldric  ▓▓▓  │
 *   │  movement, bump-attack.         │ ├──┤ Pippin  ▓▓▓  │
 *   │                                  │ ── -- TURN --      │
 *   │                                  │ > Attack            │
 *   │                                  │   Cast (4)          │
 *   │                                  │   …                  │
 *   ├──────────────────────────────────┴─────────────────┤
 *   │ Log (last ~10 lines)                                │
 *   └─────────────────────────────────────────────────────┘
 *
 * Color palette + font choices match v1's CombatScene (gold #ffd470,
 * parchment #f6efd6, accent rust #c8553d, panel-edge #2a2a3a). The
 * scene owns ALL rendering — no React inside the canvas.
 */

import Phaser from "phaser";
import { withBasePath } from "@/util/basePath";
import {
  BattleSimulation,
  type BattleAbility,
  type BattleSpell,
} from "@/sim/battle/BattleSimulation";
import { combatStatsFor } from "@/editor/combatStats";
import type { SheetItemRef } from "@/editor/CharacterSheetSim";
import type {
  PartyAbilityRef,
  PartyCharacterRef,
  PartyClassRef,
  PartyItemRef,
  PartyRaceRef,
  PartyRecord,
  PartySpellRef,
} from "@/editor/PartyScreen";
import type {
  BattleCombatant,
  BattleDirection,
  BattleEncounterRef,
  BattleEvent,
  BattleMonsterRef,
  BattleState,
} from "@/sim/battle/types";
import type { BattleSimMapRecord } from "./BattleSimMount";

// ── Layout constants ──────────────────────────────────────────────
const TILE = 32;
const HEADER_H = 32;
const PAD = 12;
const HUD_W = 348;
const LOG_H = 148;
const CARD_H = 60;
const CARD_PAD = 4;

// ── Palette (exact v1 hex) ────────────────────────────────────────
const C = {
  bg: 0x0c0c14,
  panel: 0x161629,
  panelEdge: 0x2a2a3a,
  accent: 0xc8553d,
  gold: 0xffd470,
  body: 0xf6efd6,
  dim: 0xe8dfb6,
  faint: 0x4d473e,
  hpFull: 0x6acf6a,
  hpLow: 0xd14a4a,
  mp: 0x7aa6ff,
  selectBg: 0x2a1f24,
  barBg: 0x1c1c2a,
  fallbackParty: 0x4ade80,
  fallbackMonster: 0xef4444,
} as const;
const hex = (n: number) => "#" + n.toString(16).padStart(6, "0");
const FONT_TITLE = (color: number = C.gold) => ({
  fontFamily: "Georgia, serif",
  fontSize: "20px",
  color: hex(color),
});
const FONT_HEAD = (color: number = C.gold) => ({
  fontFamily: "Georgia, serif",
  fontSize: "16px",
  color: hex(color),
});
const FONT_BODY = (color: number = C.body) => ({
  fontFamily: "Georgia, serif",
  fontSize: "14px",
  color: hex(color),
});
const FONT_MONO = (color: number = C.dim) => ({
  fontFamily: "monospace",
  fontSize: "12px",
  color: hex(color),
});

// ── Action menu (v1 PARTY_ACTIONS) ────────────────────────────────
type ActionId = "attack" | "cast" | "ability" | "end";
interface ActionEntry {
  id: ActionId;
  label: string;
}
const PARTY_ACTIONS: ActionEntry[] = [
  { id: "attack", label: "Attack" },
  { id: "cast", label: "Cast" },
  { id: "ability", label: "Use Ability" },
  { id: "end", label: "End Turn  [SPACE]" },
];

// ── Scene init data ───────────────────────────────────────────────
export interface BattleSimSceneData {
  encounter: BattleEncounterRef;
  map: BattleSimMapRecord;
  party: PartyRecord;
  characters: ReadonlyArray<PartyCharacterRef>;
  races: ReadonlyArray<PartyRaceRef>;
  classes: ReadonlyArray<PartyClassRef>;
  abilities: ReadonlyArray<PartyAbilityRef>;
  items: ReadonlyArray<PartyItemRef>;
  spells: ReadonlyArray<PartySpellRef>;
  monsters: ReadonlyArray<BattleMonsterRef>;
}

type Mode =
  | { kind: "default" }
  | { kind: "pick-spell" }
  | { kind: "pick-ability" }
  | {
      kind: "pick-target";
      label: string;
      targetSide: "enemy" | "ally" | "ally_or_self";
      onPick: (id: string) => void;
    };

export class BattleSimScene extends Phaser.Scene {
  // Renamed to avoid shadowing Phaser.Scene's own `data` field (the
  // built-in DataManager).
  private cfg!: BattleSimSceneData;
  private sim!: BattleSimulation;

  private mode: Mode = { kind: "default" };
  private actionCursor = 0;
  private pickerCursor = 0;

  // Layout origins, computed in create() from the map dimensions.
  private arenaX = PAD;
  private arenaY = HEADER_H + PAD;
  private arenaW = 0;
  private arenaH = 0;
  private hudX = 0;
  private hudY = 0;
  private hudH = 0;
  private logX = PAD;
  private logY = 0;
  private logW = 0;

  // Sprite + UI tracking
  private combatantSprites = new Map<string, Phaser.GameObjects.Image>();
  private partyCards = new Map<
    string,
    {
      frame: Phaser.GameObjects.Rectangle;
      hpBar: Phaser.GameObjects.Rectangle;
      hpText: Phaser.GameObjects.Text;
      mpBar?: Phaser.GameObjects.Rectangle;
      mpText?: Phaser.GameObjects.Text;
    }
  >();
  private turnText!: Phaser.GameObjects.Text;
  private movePointsText!: Phaser.GameObjects.Text;
  private actionTexts: Phaser.GameObjects.Text[] = [];
  private actionRowHandles: Phaser.GameObjects.Rectangle[] = [];
  private logLines: Phaser.GameObjects.Text[] = [];
  private logEntries: string[] = [];

  // Picker UI state — destroyed + recreated whenever mode changes.
  private pickerObjects: Phaser.GameObjects.GameObject[] = [];
  private outcomeObjects: Phaser.GameObjects.GameObject[] = [];

  constructor() {
    super({ key: "BattleSimScene" });
  }

  init(data: BattleSimSceneData): void {
    this.data = data;
    this.mode = { kind: "default" };
    this.actionCursor = 0;
    this.pickerCursor = 0;
    this.logEntries = [];
  }

  preload(): void {
    // Gather every sprite we'll need. Same `withBasePath` recipe the
    // map editor uses so the assets path is consistent.
    const keys = new Set<string>();
    for (const row of this.data.map.grid) {
      for (const cell of row) if (cell.sprite) keys.add(cell.sprite);
    }
    for (const c of this.data.characters) {
      if (c.sprite) keys.add(c.sprite);
    }
    for (const m of this.data.monsters) {
      if (m.sprite) keys.add(m.sprite);
    }
    for (const k of keys) {
      this.load.image(k, withBasePath(`/sprites/${k}`));
    }
  }

  create(): void {
    const m = this.data.map;
    this.arenaW = m.width * TILE;
    this.arenaH = m.height * TILE;
    this.arenaX = PAD;
    this.arenaY = HEADER_H + PAD;
    this.hudX = this.arenaX + this.arenaW + PAD;
    this.hudY = this.arenaY;
    this.hudH = Math.max(this.arenaH, 480);
    this.logX = PAD;
    this.logY = this.arenaY + this.hudH + PAD;
    this.logW = this.arenaW + HUD_W + PAD;

    this.drawHeader();
    this.drawArena();
    this.drawHud();
    this.drawLog();

    // Build initial combatants + kernel.
    const combatants = this.layOutCombatants();
    const walkable = (col: number, row: number): boolean => {
      if (col < 0 || row < 0) return false;
      if (row >= m.height) return false;
      const r = m.grid[row];
      if (!r || col >= r.length) return false;
      const cell = r[col];
      return cell.walkable !== false && !cell.obstructs;
    };
    this.sim = new BattleSimulation(
      {
        cols: m.width,
        rows: m.height,
        combatants,
        walkable,
      },
      {
        spells: this.data.spells as ReadonlyArray<BattleSpell>,
        abilities: this.data.abilities as ReadonlyArray<BattleAbility>,
      },
    );

    // Paint combatants onto the arena.
    for (const c of combatants) {
      this.placeCombatantSprite(c);
    }

    // Subscribe to kernel events. The scene mirrors them to sprite
    // moves, party-card bar updates, log lines, and outcome rendering.
    this.sim.subscribe((ev) => this.onKernelEvent(ev));

    // Initial HUD pass.
    this.refreshPartyCards();
    this.refreshTurnIndicator();
    this.refreshActionMenu();

    // If initiative landed on a monster, drain its turns immediately.
    this.pumpMonsterTurns();

    this.installInput();
  }

  // ── Layout helpers ────────────────────────────────────────────

  private drawHeader(): void {
    this.panel(0, 0, this.scale.width, HEADER_H);
    this.add
      .text(this.scale.width / 2, 6, "BATTLE", FONT_TITLE())
      .setOrigin(0.5, 0);
  }

  private drawArena(): void {
    this.panel(
      this.arenaX - 4,
      this.arenaY - 4,
      this.arenaW + 8,
      this.arenaH + 8,
    );
    const m = this.data.map;
    for (let row = 0; row < m.height; row++) {
      for (let col = 0; col < m.width; col++) {
        const cell = m.grid[row]?.[col];
        if (!cell) continue;
        const x = this.arenaX + col * TILE;
        const y = this.arenaY + row * TILE;
        const key = cell.sprite ?? "";
        if (key && this.textures.exists(key)) {
          this.add.image(x, y, key).setOrigin(0).setDisplaySize(TILE, TILE);
        } else {
          const color = cell.walkable === false ? 0x14140f : 0x14241a;
          this.add
            .rectangle(x, y, TILE, TILE, color, 1)
            .setOrigin(0)
            .setStrokeStyle(1, C.panelEdge);
        }
      }
    }
  }

  private drawHud(): void {
    this.panel(this.hudX, this.hudY, HUD_W, this.hudH);
    let cy = this.hudY + 12;

    // PARTY header
    this.add.text(this.hudX + 14, cy, "PARTY", FONT_HEAD());
    cy += 24;

    // Reserve a per-member card. The kernel may report fewer
    // combatants than the roster (missing character ids) — we draw
    // cards up to four anyway and skip missing ones in
    // `refreshPartyCards`.
    const cardW = HUD_W - 24;
    const partyIds = (this.data.party.roster ?? []).slice(0, 4);
    for (const id of partyIds) {
      const ch = this.data.characters.find((c) => c.id === id);
      if (ch) this.drawPartyCard(ch, this.hudX + 12, cy, cardW, CARD_H);
      cy += CARD_H + CARD_PAD;
    }

    cy += 8;
    this.add
      .rectangle(this.hudX + 12, cy, HUD_W - 24, 1, C.panelEdge)
      .setOrigin(0);
    cy += 10;

    // -- NAME'S TURN --
    this.turnText = this.add
      .text(this.hudX + 14, cy, "", FONT_HEAD())
      .setOrigin(0, 0);
    cy += 22;
    this.movePointsText = this.add
      .text(this.hudX + 14, cy, "", FONT_MONO())
      .setOrigin(0, 0);
    cy += 24;

    // Action menu — clickable rows so the player isn't keyboard-only.
    for (let i = 0; i < PARTY_ACTIONS.length; i++) {
      const ry = cy + i * 22;
      const handle = this.add
        .rectangle(this.hudX + 12, ry, HUD_W - 24, 22, C.selectBg, 0)
        .setOrigin(0)
        .setInteractive({ useHandCursor: true });
      handle.on("pointerdown", () => {
        this.actionCursor = i;
        this.activateAction();
      });
      const t = this.add.text(this.hudX + 24, ry + 2, "", FONT_BODY());
      this.actionRowHandles.push(handle);
      this.actionTexts.push(t);
    }
  }

  private drawPartyCard(
    c: PartyCharacterRef,
    x: number,
    y: number,
    w: number,
    h: number,
  ): void {
    const frame = this.add
      .rectangle(x, y, w, h, C.barBg, 1)
      .setOrigin(0)
      .setStrokeStyle(1, C.panelEdge);

    const avatar = 44;
    if (c.sprite && this.textures.exists(c.sprite)) {
      this.add
        .image(x + 8, y + 8, c.sprite)
        .setOrigin(0)
        .setDisplaySize(avatar, avatar);
    } else {
      this.add
        .rectangle(x + 8, y + 8, avatar, avatar, C.fallbackParty)
        .setOrigin(0);
    }
    const tx = x + avatar + 16;
    this.add.text(tx, y + 4, c.name, FONT_BODY());

    const barW = w - (tx - x) - 12;
    const fullBarW = barW - 2;

    // HP bar
    const hpBarY = y + 22;
    this.add
      .rectangle(tx, hpBarY, barW, 8, C.barBg, 1)
      .setOrigin(0)
      .setStrokeStyle(1, C.panelEdge);
    const hpBar = this.add
      .rectangle(tx + 1, hpBarY + 1, fullBarW, 6, C.hpFull, 1)
      .setOrigin(0);
    const hpText = this.add
      .text(tx + barW - 2, hpBarY - 14, `${c.hp}/${c.hp}`, FONT_MONO())
      .setOrigin(1, 0);

    // MP bar — casters only.
    let mpBar: Phaser.GameObjects.Rectangle | undefined;
    let mpText: Phaser.GameObjects.Text | undefined;
    const maxMp = c.mp ?? 0;
    if (maxMp > 0) {
      const mpBarY = y + 44;
      this.add
        .rectangle(tx, mpBarY, barW, 8, C.barBg, 1)
        .setOrigin(0)
        .setStrokeStyle(1, C.panelEdge);
      mpBar = this.add
        .rectangle(tx + 1, mpBarY + 1, fullBarW, 6, C.mp, 1)
        .setOrigin(0);
      mpText = this.add
        .text(tx + barW - 2, mpBarY - 14, `${maxMp}/${maxMp}`, FONT_MONO())
        .setOrigin(1, 0);
    }

    this.partyCards.set(c.id, { frame, hpBar, hpText, mpBar, mpText });
  }

  private drawLog(): void {
    this.panel(this.logX, this.logY, this.logW, LOG_H);
    this.add.text(this.logX + 12, this.logY + 8, "LOG", FONT_HEAD());
    // Pre-create 10 log line texts; we slide content through them.
    for (let i = 0; i < 10; i++) {
      const t = this.add
        .text(
          this.logX + 12,
          this.logY + 30 + i * 14,
          "",
          FONT_MONO(C.body),
        )
        .setOrigin(0, 0);
      this.logLines.push(t);
    }
  }

  /** Panel rectangle in v1's style — dark navy with edge stroke. */
  private panel(x: number, y: number, w: number, h: number): void {
    this.add
      .rectangle(x, y, w, h, C.panel, 1)
      .setOrigin(0)
      .setStrokeStyle(1, C.panelEdge);
  }

  // ── Setup ─────────────────────────────────────────────────────

  /** Build BattleCombatant array. Party members spawn on the first
   *  walkable cells we find, monsters on the far side of the map. */
  private layOutCombatants(): BattleCombatant[] {
    const out: BattleCombatant[] = [];
    const m = this.data.map;
    const itemById = new Map(
      this.data.items.map((it) => [it.id, it]),
    ) as ReadonlyMap<string, SheetItemRef>;
    const classById = new Map(this.data.classes.map((c) => [c.id, c]));
    const monstersById = new Map(this.data.monsters.map((mm) => [mm.id, mm]));
    const occupied = new Set<string>();
    const walkable = (col: number, row: number): boolean => {
      if (col < 0 || row < 0 || row >= m.height) return false;
      const r = m.grid[row];
      if (!r || col >= r.length) return false;
      const cell = r[col];
      return cell.walkable !== false && !cell.obstructs;
    };

    // Party: walk rows top-to-bottom near the left edge until we have
    // a slot per roster member.
    const partyIds = this.data.party.roster ?? [];
    const partyMembers = partyIds
      .map((id) => this.data.characters.find((c) => c.id === id))
      .filter((c): c is PartyCharacterRef => Boolean(c));
    let placed = 0;
    outer: for (
      let col = 1;
      col < m.width && placed < partyMembers.length;
      col++
    ) {
      for (let row = 1; row < m.height; row++) {
        if (placed >= partyMembers.length) break outer;
        if (!walkable(col, row)) continue;
        const key = `${col},${row}`;
        if (occupied.has(key)) continue;
        const ch = partyMembers[placed];
        const combat = combatStatsFor(ch, itemById);
        const klass = classById.get(ch.class);
        const moveRange =
          (klass as { range?: number } | undefined)?.range ?? 4;
        out.push({
          id: ch.id,
          side: "party",
          name: ch.name,
          sprite: ch.sprite ?? "",
          pos: { col, row },
          hp: ch.hp ?? 1,
          maxHp: ch.hp ?? 1,
          mp: ch.mp ?? 0,
          maxMp: ch.mp ?? 0,
          ac: combat.ac,
          attackBonus: combat.attackBonus,
          damage: combat.damage,
          strength: ch.strength ?? 10,
          dexterity: ch.dexterity ?? 10,
          constitution: ch.constitution ?? 10,
          intelligence: ch.intelligence ?? 10,
          wisdom: ch.wisdom ?? 10,
          moveRange,
          dead: (ch.hp ?? 0) <= 0,
          xpReward: 0,
          weaponName: combat.weaponName,
          aiControlled: false,
        });
        occupied.add(key);
        placed++;
      }
    }

    // Monsters: walk rows top-to-bottom near the right edge.
    let monstersPlaced = 0;
    const monsterList = encounterMonsters(this.data.encounter);
    outer2: for (
      let col = m.width - 2;
      col > 0 && monstersPlaced < monsterList.length;
      col--
    ) {
      for (let row = 1; row < m.height; row++) {
        if (monstersPlaced >= monsterList.length) break outer2;
        if (!walkable(col, row)) continue;
        const key = `${col},${row}`;
        if (occupied.has(key)) continue;
        const mid = monsterList[monstersPlaced];
        const def = monstersById.get(mid);
        if (!def) {
          monstersPlaced++;
          continue;
        }
        const dup = monsterList.filter((x) => x === mid).length > 1;
        out.push({
          id: `${mid}_${monstersPlaced}`,
          side: "monster",
          name: dup
            ? `${def.name ?? mid} #${monstersPlaced + 1}`
            : def.name ?? mid,
          sprite: def.sprite ?? "",
          pos: { col, row },
          hp: def.hp ?? 1,
          maxHp: def.hp ?? 1,
          mp: 0,
          maxMp: 0,
          ac: def.ac ?? 10,
          attackBonus: def.attack_bonus ?? 0,
          damage: {
            dice: def.damage_dice ?? 1,
            sides: def.damage_sides ?? 4,
            bonus: def.damage_bonus ?? 0,
          },
          strength: 10,
          dexterity: 10,
          constitution: 10,
          intelligence: 10,
          wisdom: 10,
          moveRange: def.move_range ?? 4,
          dead: false,
          xpReward: def.xp_reward ?? 0,
          weaponName: null,
          aiControlled: true,
        });
        occupied.add(key);
        monstersPlaced++;
      }
    }

    return out;
  }

  private placeCombatantSprite(c: BattleCombatant): void {
    const px = this.arenaX + c.pos.col * TILE + TILE / 2;
    const py = this.arenaY + c.pos.row * TILE + TILE / 2;
    let img: Phaser.GameObjects.Image;
    if (c.sprite && this.textures.exists(c.sprite)) {
      img = this.add
        .image(px, py, c.sprite)
        .setOrigin(0.5)
        .setDisplaySize(TILE, TILE)
        .setDepth(50);
    } else {
      const fallbackKey =
        c.side === "party"
          ? "__combatant_party_fallback"
          : "__combatant_monster_fallback";
      if (!this.textures.exists(fallbackKey)) {
        const g = this.add.graphics();
        g.fillStyle(
          c.side === "party" ? C.fallbackParty : C.fallbackMonster,
          1,
        );
        g.fillCircle(16, 16, 13);
        g.lineStyle(2, 0x1a1a2e, 1);
        g.strokeCircle(16, 16, 13);
        g.generateTexture(fallbackKey, 32, 32);
        g.destroy();
      }
      img = this.add
        .image(px, py, fallbackKey)
        .setOrigin(0.5)
        .setDisplaySize(TILE, TILE)
        .setDepth(50);
    }
    this.combatantSprites.set(c.id, img);
  }

  // ── Event handling ────────────────────────────────────────────

  private onKernelEvent(ev: BattleEvent): void {
    if (ev.kind === "log") this.pushLog(ev.message);
    if (ev.kind === "moved") {
      const sprite = this.combatantSprites.get(ev.combatantId);
      if (sprite) {
        sprite.setPosition(
          this.arenaX + ev.to.col * TILE + TILE / 2,
          this.arenaY + ev.to.row * TILE + TILE / 2,
        );
      }
    }
    if (ev.kind === "killed") {
      const sprite = this.combatantSprites.get(ev.combatantId);
      if (sprite) {
        sprite.setAlpha(0.25);
        sprite.setTint(0x666666);
      }
    }
    if (
      ev.kind === "turn_started" ||
      ev.kind === "round_started" ||
      ev.kind === "attack" ||
      ev.kind === "moved" ||
      ev.kind === "killed" ||
      ev.kind === "cast" ||
      ev.kind === "ability"
    ) {
      this.refreshPartyCards();
      this.refreshTurnIndicator();
      this.refreshActionMenu();
      this.refreshActiveHighlight();
    }
    if (ev.kind === "outcome") this.renderOutcome();
  }

  private refreshActiveHighlight(): void {
    const active = this.sim.activeCombatant();
    for (const [id, img] of this.combatantSprites) {
      img.setStrokeColor?.(undefined as unknown as number);
    }
    if (!active) return;
    const sprite = this.combatantSprites.get(active.id);
    if (!sprite) return;
    // Use a tween to nudge the active sprite slightly larger as a
    // visual cursor without redrawing a separate ring.
    sprite.setScale(1.15);
    for (const [id, img] of this.combatantSprites) {
      if (id !== active.id) img.setScale(1);
    }
  }

  private refreshPartyCards(): void {
    const snap = this.sim.snapshot();
    for (const c of snap.combatants) {
      if (c.side !== "party") continue;
      const card = this.partyCards.get(c.id);
      if (!card) continue;
      const fullBarW = (card.hpBar.width ?? 0) || 0;
      const totalHpW = Math.max(0, fullBarW);
      // Bar geometry is fixed at draw time — we adjust display width.
      const hpPct = c.maxHp > 0 ? c.hp / c.maxHp : 0;
      card.hpBar.displayWidth = totalHpW > 0 ? totalHpW : (HUD_W - 24 - 60) - 2;
      // Recompute clean width from the bar's intrinsic frame.
      const baseW = (HUD_W - 24 - 60) - 2; // matches drawPartyCard's fullBarW
      card.hpBar.displayWidth = Math.max(0, baseW * hpPct);
      card.hpBar.setFillStyle(hpPct < 0.35 ? C.hpLow : C.hpFull);
      card.hpText.setText(`${c.hp}/${c.maxHp}`);
      if (card.mpBar && card.mpText) {
        const mpPct = c.maxMp > 0 ? c.mp / c.maxMp : 0;
        card.mpBar.displayWidth = Math.max(0, baseW * mpPct);
        card.mpText.setText(`${c.mp}/${c.maxMp}`);
      }
      // Dim dead members.
      card.frame.setAlpha(c.dead ? 0.4 : 1);
    }
  }

  private refreshTurnIndicator(): void {
    const active = this.sim.activeCombatant();
    if (!active) {
      this.turnText.setText("");
      this.movePointsText.setText("");
      return;
    }
    const suffix = active.side === "monster" ? "" : "'S";
    this.turnText.setText(`-- ${active.name.toUpperCase()}${suffix} TURN --`);
    if (active.aiControlled) {
      this.movePointsText.setText("Monster acting…");
    } else {
      const snap = this.sim.snapshot();
      this.movePointsText.setText(
        `Move points: ${snap.movePoints} / ${active.moveRange}`,
      );
    }
  }

  private refreshActionMenu(): void {
    const active = this.sim.activeCombatant();
    const playerTurn = !!active && !active.aiControlled && !active.dead;
    const battleOver =
      this.sim.snapshot().outcome.kind !== "in_progress";
    const partyChar = active
      ? this.data.characters.find((c) => c.id === active.id) ?? null
      : null;
    const partyClass = partyChar
      ? this.data.classes.find((c) => c.id === partyChar.class) ?? null
      : null;
    const battleSpellCount = partyChar
      ? this.computeBattleSpells(partyChar, partyClass).length
      : 0;
    const battleAbilityCount = partyChar
      ? this.computeBattleAbilities(partyChar, partyClass).length
      : 0;

    const isEnabled = (id: ActionId): boolean => {
      if (!playerTurn || battleOver) return false;
      if (id === "cast") return battleSpellCount > 0;
      if (id === "ability") return battleAbilityCount > 0;
      return true;
    };

    for (let i = 0; i < PARTY_ACTIONS.length; i++) {
      const a = PARTY_ACTIONS[i];
      const enabled = isEnabled(a.id);
      const cursor = playerTurn && i === this.actionCursor;
      const text = this.actionTexts[i];
      const handle = this.actionRowHandles[i];
      const color = enabled ? C.body : C.faint;
      text.setColor(hex(color));
      const prefix = cursor ? "> " : "  ";
      let count = "";
      if (a.id === "cast") count = `  (${battleSpellCount})`;
      else if (a.id === "ability") count = `  (${battleAbilityCount})`;
      const suffix = enabled ? "" : "  —";
      text.setText(`${prefix}${a.label}${count}${suffix}`);
      handle.setFillStyle(C.selectBg, cursor && enabled ? 1 : 0);
    }
  }

  private computeBattleSpells(
    member: PartyCharacterRef,
    klass: PartyClassRef | null,
  ): PartySpellRef[] {
    if (!klass?.casting_type) return [];
    return this.data.spells.filter((s) => {
      if (!s.casting_type) return false;
      if (!klass.casting_type!.includes(s.casting_type)) return false;
      if (!(s.usable_in ?? []).includes("battle")) return false;
      const gate = s.class_min_levels?.[klass.id] ?? s.min_level ?? 1;
      return (member.level ?? 1) >= gate;
    });
  }

  private computeBattleAbilities(
    member: PartyCharacterRef,
    klass: PartyClassRef | null,
  ): PartyAbilityRef[] {
    const race = this.data.races.find((r) => r.id === member.race);
    const ids = new Set<string>();
    for (const id of race?.abilities ?? []) ids.add(id);
    if (klass) {
      for (const link of klass.abilities ?? []) {
        if ((link.min_level ?? 1) <= (member.level ?? 1)) {
          const id = link.ability_id ?? link.id;
          if (id) ids.add(id);
        }
      }
    }
    return this.data.abilities.filter(
      (a) => ids.has(a.id) && (a.usable_in ?? []).includes("battle"),
    );
  }

  // ── Input ─────────────────────────────────────────────────────

  private installInput(): void {
    const k = this.input.keyboard;
    if (!k) return;
    k.on("keydown-UP", () => this.handleArrowOrMenu("up"));
    k.on("keydown-DOWN", () => this.handleArrowOrMenu("down"));
    k.on("keydown-LEFT", () => this.handleArrowOrMenu("left"));
    k.on("keydown-RIGHT", () => this.handleArrowOrMenu("right"));
    k.on("keydown-W", () => this.handleArrowOrMenu("up"));
    k.on("keydown-S", () => this.handleArrowOrMenu("down"));
    k.on("keydown-A", () => this.handleArrowOrMenu("left"));
    k.on("keydown-D", () => this.handleArrowOrMenu("right"));
    k.on("keydown-ENTER", () => this.activateAction());
    k.on("keydown-SPACE", () => this.endTurn());
    k.on("keydown-ESC", () => this.cancelPicker());
  }

  private handleArrowOrMenu(key: "up" | "down" | "left" | "right"): void {
    if (this.mode.kind === "pick-spell" || this.mode.kind === "pick-ability") {
      if (key === "up") this.movePickerCursor(-1);
      else if (key === "down") this.movePickerCursor(1);
      return;
    }
    if (this.mode.kind === "pick-target") {
      // Number-key path is simpler; ESC cancels via cancelPicker.
      return;
    }
    // Default mode — arrows DRIVE the active combatant on the map
    // unless the active is a monster.
    const active = this.sim.activeCombatant();
    if (!active || active.aiControlled) return;
    if (key === "up" || key === "down") {
      // v1 treats up/down inside the action menu as cursor moves.
      // We mirror that — but ONLY if the cursor is in the menu region
      // (i.e. always, in our case). Use Shift+arrows for movement? No —
      // simpler: bind up/down to menu, left/right to movement, like v1.
      // (v1 sends up/down to the action menu, arrows to combat are
      // wrapper'd in tryPlayerStep.) Here we mirror: up/down adjust
      // the menu cursor; LEFT/RIGHT/W/A/S/D move the combatant.
      this.moveActionCursor(key === "up" ? -1 : 1);
      return;
    }
    const dir: BattleDirection =
      key === "left" ? "w" : key === "right" ? "e" : "e";
    // wait — the function gets up/down/left/right only; mapping:
    //   up -> n, down -> s, left -> w, right -> e (but up/down already
    //   handled above for menu navigation). Movement is left/right.
    // To support full cardinal step we also accept W/A/S/D for true
    // 4-way movement, which is the v1 convention. Let me re-route.
    void dir;
    if (key === "left") this.tryPlayerStep("w");
    else if (key === "right") this.tryPlayerStep("e");
  }

  private moveActionCursor(delta: number): void {
    const n = PARTY_ACTIONS.length;
    this.actionCursor = (this.actionCursor + delta + n) % n;
    this.refreshActionMenu();
  }

  private movePickerCursor(delta: number): void {
    const total = this.currentPickerCount();
    if (total === 0) return;
    this.pickerCursor = (this.pickerCursor + delta + total) % total;
    this.renderPicker();
  }

  private currentPickerCount(): number {
    if (this.mode.kind === "pick-spell" || this.mode.kind === "pick-ability") {
      const active = this.sim.activeCombatant();
      if (!active) return 0;
      const partyChar =
        this.data.characters.find((c) => c.id === active.id) ?? null;
      const partyClass = partyChar
        ? this.data.classes.find((c) => c.id === partyChar.class) ?? null
        : null;
      if (!partyChar) return 0;
      return this.mode.kind === "pick-spell"
        ? this.computeBattleSpells(partyChar, partyClass).length
        : this.computeBattleAbilities(partyChar, partyClass).length;
    }
    return 0;
  }

  private tryPlayerStep(direction: BattleDirection): void {
    if (this.mode.kind !== "default") return;
    if (this.sim.snapshot().outcome.kind !== "in_progress") return;
    this.sim.tryMove(direction);
    const active = this.sim.activeCombatant();
    const snap = this.sim.snapshot();
    if (
      active &&
      active.side === "party" &&
      snap.movePoints <= 0 &&
      snap.outcome.kind === "in_progress"
    ) {
      this.sim.submitAction({ kind: "end_turn" });
      this.pumpMonsterTurns();
    }
  }

  private endTurn(): void {
    if (this.mode.kind !== "default") return;
    if (this.sim.snapshot().outcome.kind !== "in_progress") return;
    const active = this.sim.activeCombatant();
    if (!active || active.aiControlled) return;
    this.sim.submitAction({ kind: "end_turn" });
    this.pumpMonsterTurns();
  }

  private activateAction(): void {
    if (this.mode.kind === "pick-spell") {
      const list = this.currentPickerSpells();
      const spell = list[this.pickerCursor];
      if (!spell) return;
      this.handleCastChoice(spell);
      return;
    }
    if (this.mode.kind === "pick-ability") {
      const list = this.currentPickerAbilities();
      const ability = list[this.pickerCursor];
      if (!ability) return;
      this.sim.submitAction({
        kind: "use_ability",
        abilityId: ability.id,
        targetId: null,
      });
      this.closePicker();
      this.pumpMonsterTurns();
      return;
    }
    if (this.mode.kind === "pick-target") {
      // Pick-target uses on-canvas number keys / clicks; ignore enter.
      return;
    }
    const a = PARTY_ACTIONS[this.actionCursor];
    if (!a) return;
    const active = this.sim.activeCombatant();
    if (!active || active.aiControlled) return;
    switch (a.id) {
      case "attack":
        this.sim.submitAction({ kind: "attack" });
        this.pumpMonsterTurns();
        break;
      case "cast":
        this.openPicker("pick-spell");
        break;
      case "ability":
        this.openPicker("pick-ability");
        break;
      case "end":
        this.endTurn();
        break;
    }
  }

  private handleCastChoice(spell: PartySpellRef): void {
    const targeting = spell.targeting ?? "self";
    const needsEnemy =
      targeting === "select_enemy" ||
      targeting === "directional_projectile";
    const needsAlly =
      targeting === "select_ally" || targeting === "select_ally_or_self";
    if (!needsEnemy && !needsAlly) {
      this.sim.submitAction({ kind: "cast", spellId: spell.id, targetId: null });
      this.closePicker();
      this.pumpMonsterTurns();
      return;
    }
    // Open the target picker — for MVP we just pick by clicking a
    // combatant sprite on the arena.
    this.mode = {
      kind: "pick-target",
      label: `Pick a target for ${spell.name ?? spell.id}`,
      targetSide: needsAlly
        ? targeting === "select_ally_or_self"
          ? "ally_or_self"
          : "ally"
        : "enemy",
      onPick: (id) => {
        this.sim.submitAction({
          kind: "cast",
          spellId: spell.id,
          targetId: id,
        });
        this.closePicker();
        this.pumpMonsterTurns();
      },
    };
    this.armTargetClickHandlers();
    this.renderPicker();
  }

  private armTargetClickHandlers(): void {
    if (this.mode.kind !== "pick-target") return;
    const side = this.mode.targetSide;
    const active = this.sim.activeCombatant();
    for (const [id, img] of this.combatantSprites) {
      img.removeAllListeners("pointerdown");
      img.removeInteractive();
      const c = this.sim
        .snapshot()
        .combatants.find((x) => x.id === id);
      if (!c || c.dead) continue;
      const ok =
        side === "enemy"
          ? c.side === "monster"
          : side === "ally"
            ? c.side === "party" && c.id !== active?.id
            : c.side === "party";
      if (!ok) continue;
      img.setInteractive({ useHandCursor: true });
      img.on("pointerdown", () => {
        if (this.mode.kind === "pick-target") this.mode.onPick(id);
      });
    }
  }

  private openPicker(kind: "pick-spell" | "pick-ability"): void {
    this.mode = { kind } as Mode;
    this.pickerCursor = 0;
    this.renderPicker();
  }

  private cancelPicker(): void {
    if (this.mode.kind === "default") return;
    this.closePicker();
  }

  private closePicker(): void {
    this.mode = { kind: "default" };
    for (const o of this.pickerObjects) o.destroy();
    this.pickerObjects = [];
    // Remove target handlers from combatant sprites.
    for (const img of this.combatantSprites.values()) {
      img.removeAllListeners("pointerdown");
      img.removeInteractive();
    }
    this.refreshActionMenu();
  }

  private renderPicker(): void {
    for (const o of this.pickerObjects) o.destroy();
    this.pickerObjects = [];
    if (this.mode.kind === "default") return;

    // Modal floating over the HUD panel.
    const px = this.hudX + 8;
    const py = this.hudY + 240;
    const pw = HUD_W - 16;
    const ph = 200;
    const bg = this.add
      .rectangle(px, py, pw, ph, C.panel, 1)
      .setOrigin(0)
      .setStrokeStyle(2, C.gold)
      .setDepth(100);
    this.pickerObjects.push(bg);
    let title = "";
    if (this.mode.kind === "pick-spell") title = "CAST WHICH SPELL?";
    else if (this.mode.kind === "pick-ability") title = "USE WHICH ABILITY?";
    else if (this.mode.kind === "pick-target") title = this.mode.label;
    const t = this.add
      .text(px + 10, py + 8, title, FONT_HEAD())
      .setDepth(101);
    this.pickerObjects.push(t);
    const hint = this.add
      .text(
        px + pw - 10,
        py + 8,
        "ESC to cancel",
        FONT_MONO(),
      )
      .setOrigin(1, 0)
      .setDepth(101);
    this.pickerObjects.push(hint);

    if (this.mode.kind === "pick-target") {
      const inst = this.add
        .text(
          px + 10,
          py + 36,
          "Click a combatant on the arena.",
          FONT_BODY(),
        )
        .setDepth(101);
      this.pickerObjects.push(inst);
      return;
    }
    const list =
      this.mode.kind === "pick-spell"
        ? this.currentPickerSpells()
        : this.currentPickerAbilities();
    list.forEach((item, i) => {
      const ry = py + 36 + i * 20;
      const cursor = i === this.pickerCursor;
      const row = this.add
        .rectangle(px + 8, ry, pw - 16, 20, C.selectBg, cursor ? 1 : 0)
        .setOrigin(0)
        .setDepth(101)
        .setInteractive({ useHandCursor: true });
      row.on("pointerdown", () => {
        this.pickerCursor = i;
        this.activateAction();
      });
      const label =
        "name" in item && item.name ? item.name : item.id;
      const detail =
        this.mode.kind === "pick-spell"
          ? `MP ${(item as PartySpellRef).mp_cost ?? 0}`
          : (item as PartyAbilityRef).type ?? "";
      const text = this.add
        .text(
          px + 20,
          ry + 2,
          `${cursor ? "> " : "  "}${label}`,
          FONT_BODY(),
        )
        .setDepth(101);
      const detailText = this.add
        .text(px + pw - 14, ry + 4, detail, FONT_MONO())
        .setOrigin(1, 0)
        .setDepth(101);
      this.pickerObjects.push(row, text, detailText);
    });
  }

  private currentPickerSpells(): PartySpellRef[] {
    const active = this.sim.activeCombatant();
    if (!active) return [];
    const ch = this.data.characters.find((c) => c.id === active.id) ?? null;
    const klass = ch
      ? this.data.classes.find((c) => c.id === ch.class) ?? null
      : null;
    return ch ? this.computeBattleSpells(ch, klass) : [];
  }

  private currentPickerAbilities(): PartyAbilityRef[] {
    const active = this.sim.activeCombatant();
    if (!active) return [];
    const ch = this.data.characters.find((c) => c.id === active.id) ?? null;
    const klass = ch
      ? this.data.classes.find((c) => c.id === ch.class) ?? null
      : null;
    return ch ? this.computeBattleAbilities(ch, klass) : [];
  }

  // ── Monster AI pump (matches MapBattleController) ─────────────

  private pumpMonsterTurns(): void {
    let safety = 200;
    while (safety-- > 0) {
      const active = this.sim.activeCombatant();
      if (!active) return;
      if (this.sim.snapshot().outcome.kind !== "in_progress") return;
      if (!active.aiControlled) return;
      const intent = this.sim.nextMonsterIntent();
      if (intent.kind === "wait") {
        this.sim.submitAction({ kind: "end_turn" });
        continue;
      }
      this.sim.tryMove(intent.direction);
      if (this.sim.snapshot().movePoints <= 0) {
        this.sim.submitAction({ kind: "end_turn" });
      }
    }
  }

  // ── Outcome ───────────────────────────────────────────────────

  private renderOutcome(): void {
    for (const o of this.outcomeObjects) o.destroy();
    this.outcomeObjects = [];
    const outcome = this.sim.snapshot().outcome;
    if (outcome.kind === "in_progress") return;
    const cx = this.arenaX + this.arenaW / 2;
    const cy = this.arenaY + this.arenaH / 2;
    const w = 360;
    const h = 140;
    const bg = this.add
      .rectangle(cx - w / 2, cy - h / 2, w, h, C.panel, 0.95)
      .setOrigin(0)
      .setStrokeStyle(2, C.gold)
      .setDepth(200);
    let title = "BATTLE OVER";
    let detail = "";
    if (outcome.kind === "victory") {
      title = "VICTORY!";
      detail = `+${outcome.xpEarned} XP · +${outcome.goldEarned} gold`;
    } else if (outcome.kind === "defeat") {
      title = "DEFEAT";
      detail = "Your party has fallen.";
    } else if (outcome.kind === "fled") {
      title = "FLED";
      detail = "You escaped the encounter.";
    }
    const t1 = this.add
      .text(cx, cy - 30, title, {
        ...FONT_TITLE(C.gold),
        fontSize: "32px",
      })
      .setOrigin(0.5)
      .setDepth(201);
    const t2 = this.add
      .text(cx, cy + 10, detail, FONT_BODY())
      .setOrigin(0.5)
      .setDepth(201);
    this.outcomeObjects.push(bg, t1, t2);
  }

  // ── Log ───────────────────────────────────────────────────────

  private pushLog(message: string): void {
    this.logEntries.push(message);
    if (this.logEntries.length > 10) this.logEntries.shift();
    for (let i = 0; i < this.logLines.length; i++) {
      this.logLines[i].setText(this.logEntries[i] ?? "");
    }
  }
}

// ── Helpers ───────────────────────────────────────────────────────

function encounterMonsters(e: BattleEncounterRef): string[] {
  return e.monsters ?? [];
}
