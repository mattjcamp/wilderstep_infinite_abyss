{
  "name": "wilderstep-infinite-abyss-web",
  "version": "0.1.0",
  "private": true,
  "description": "Wilderstep: Infinite Abyss \u2014 Next.js web app (game + module editor).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "publish-server": "node scripts/publish-server.mjs",
    "reindex-sprites": "node scripts/reindex-sprites.mjs",
    "reindex-audio": "node scripts/reindex-audio.mjs",
    "dev:all": "node scripts/reindex-audio.mjs && (node scripts/publish-server.mjs & next dev)",
    "dev:remote": "NEXT_PUBLIC_MODULE_SOURCE=remote NEXT_PUBLIC_READ_HOST=https://wilderstep-publish-api.wilderstep.workers.dev NEXT_PUBLIC_PUBLISH_HOST=https://wilderstep-publish-api.wilderstep.workers.dev next dev",
    "build:pages": "STATIC_EXPORT=1 NEXT_PUBLIC_MODULE_SOURCE=remote NEXT_PUBLIC_READ_HOST=https://wilderstep-publish-api.wilderstep.workers.dev NEXT_PUBLIC_PUBLISH_HOST=https://wilderstep-publish-api.wilderstep.workers.dev next build"
  },
  "dependencies": {
    "next": "14.2.18",
    "phaser": "^4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "vitest": "^1.6.1"
  }
}
